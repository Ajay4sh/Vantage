# Copy to apps/web/.env.local and fill in. Never commit .env.local.

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Where Upstox redirects after login — must match the redirect URI registered
# with your Upstox app. Only used by scripts/refresh-token.ts.
UPSTOX_REDIRECT_URI=http://localhost:3100/callback
# Standard token: expires daily, refresh via `npm run refresh-token` each morning.
UPSTOX_ACCESS_TOKEN=
# Optional: generated once, no daily refresh, covers read-only market data only.
UPSTOX_ANALYTICS_TOKEN=

# Postgres for saved watchlists/notes/alerts. Without it, the app uses an
# in-memory store (fine for local/demo; non-durable). Schema in apps/web/db/schema.sql.
DATABASE_URL=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ===== Phase 7/8: accounts, auth, alerts =====
# Secret used to sign session JWTs (Phase 7.1). Set a long random string in
# production; a dev fallback is used if unset so local login still works.
AUTH_SECRET=
# SMS OTP delivery via MSG91 (Phase 7.1). Without it, the OTP is shown on the
# login screen (dev mode) so auth is testable with no gateway.
MSG91_AUTH_KEY=
MSG91_SENDER=VNTAGE
MSG91_TEMPLATE_ID=
# Protects the alert-evaluation cron (Phase 8.2). Vercel Cron sends it as a
# Bearer token; set it in the Vercel dashboard.
CRON_SECRET=
# Firebase Cloud Messaging server key for web push (Phase 8.2). Without it,
# the in-app notification center is the delivery channel.
FCM_SERVER_KEY=

# ===== Phase 4: news + sentiment =====
# Headline source (NewsAPI.org). Without it, news is sample-only for the demo
# six and empty elsewhere (headlines are never synthesized).
NEWSAPI_KEY=
# Sentiment classifier. With an Anthropic key, headlines are tagged by Claude;
# without one, a transparent keyword heuristic tags them so the demo still works.
ANTHROPIC_API_KEY=
# Optional: override the classifier model. Defaults to claude-opus-5; set
# claude-haiku-4-5 for cheaper bulk classification.
ANTHROPIC_MODEL=

# Only add these if you bring in a fallback source (see build instructions §2)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
